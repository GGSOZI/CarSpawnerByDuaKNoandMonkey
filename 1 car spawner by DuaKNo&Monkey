local function ragdoll(npc, launch)
	if npc.ragdolled then return end
	npc.ragdolled = true
	local model, hum, root = npc.model, npc.humanoid, npc.root
	npc.wasAnchored = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored then
			npc.wasAnchored[d] = true
			d.Anchored = false
		end
	end
	npc.rootCollide = root.CanCollide
	if npc.real then
		npc.oldNeck, npc.oldBreak = hum.RequiresNeck, hum.BreakJointsOnDeath
		hum.RequiresNeck = false
		hum.BreakJointsOnDeath = false
		Net.apply()
	end
	stopAnims(npc)
	hum:Move(Vector3.zero, false)
	hum.AutoRotate = false
	hum.PlatformStand = true
	pcall(function() hum.EvaluateStateMachine = false end)
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	root.CanCollide = false

	local folder = Instance.new("Folder")
	folder.Name = "RagdollParts"
	folder.Parent = model
	npc.ragFolder = folder

	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Name ~= "Root" and m.Name ~= "RootJoint" and m.Part0 and m.Part1 then
			local nm = m.Name
			local a0 = Instance.new("Attachment")
			a0.Name = "MonkeyRagA0"
			a0.CFrame = m.C0
			a0.Parent = m.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "MonkeyRagA1"
			a1.CFrame = m.C1
			a1.Parent = m.Part1
			local b = Instance.new("BallSocketConstraint")
			b.Attachment0 = a0
			b.Attachment1 = a1
			b.LimitsEnabled = true
			local hinge = nm:find("Elbow") or nm:find("Knee")
			b.UpperAngle = hinge and 55 or ((nm == "Waist" or nm == "Neck") and 40 or 80)
			b.TwistLimitsEnabled = true
			b.TwistLowerAngle = hinge and -10 or -40
			b.TwistUpperAngle = hinge and 10 or 40
			b.MaxFrictionTorque = 3
			b.Parent = folder
			local nc = Instance.new("NoCollisionConstraint")
			nc.Part0 = m.Part0
			nc.Part1 = m.Part1
			nc.Parent = folder
			m.Enabled = false
			table.insert(npc.motors, m)
			table.insert(npc.attachments, a0)
			table.insert(npc.attachments, a1)
		end
	end

	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			if part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
			for _, car in ipairs(cars) do
				local nc = Instance.new("NoCollisionConstraint")
				nc.Part0 = part
				nc.Part1 = car.chassis
				nc.Parent = folder
			end
		end
	end

	npc.recoverAt = os.clock() + 4 + math.random() * 2

	task.spawn(function()
		RunService.Heartbeat:Wait()
		if not npc.root.Parent then return end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.AssemblyLinearVelocity = launch
			end
		end
		local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or npc.root
		torso.AssemblyAngularVelocity = Vector3.new(math.random(-9, 9), math.random(-9, 9), math.random(-9, 9))
	end)
end

local function recoverNpc(npc)
	if npc.recovering or npc.dead then return end
	npc.recovering = true
	task.spawn(function()
		local model, hum, root = npc.model, npc.humanoid, npc.root
		if not (root and root.Parent and model.Parent) then
			npc.recovering = false
			return
		end
		Net.apply()
		for _, a in ipairs(npc.attachments) do
			if a.Parent then a:Destroy() end
		end
		if npc.ragFolder then npc.ragFolder:Destroy() end
		local motors = npc.motors
		npc.motors, npc.attachments, npc.ragFolder = {}, {}, nil

		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = player.Character and { model, world, player.Character } or { model, world }
		local res = Workspace:Raycast(root.Position + Vector3.new(0, 3, 0), Vector3.new(0, -400, 0), rp)
		local height
		if hum.RigType == Enum.HumanoidRigType.R15 then
			height = hum.HipHeight + root.Size.Y / 2
		else
			local leg = model:FindFirstChild("Left Leg")
			height = (leg and leg.Size.Y or 2) + root.Size.Y / 2
		end
		local inAir = (not res) or (root.Position.Y - res.Position.Y) > height + 3
		local y = inAir and root.Position.Y or (res.Position.Y + height + 0.15)
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.3 then
			local up = root.CFrame.UpVector
			flat = Vector3.new(up.X, 0, up.Z)
		end
		if flat.Magnitude < 0.3 then
			flat = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
		end
		local yaw = math.atan2(-flat.Unit.X, -flat.Unit.Z)

		local parts = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				parts[#parts + 1] = d
				d.Anchored = true
				d.AssemblyLinearVelocity = Vector3.zero
				d.AssemblyAngularVelocity = Vector3.zero
			end
		end
		root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z) * CFrame.Angles(0, yaw, 0)
		Net.snapToRest(model, root)
		for _, m in ipairs(motors) do
			if m.Parent then m.Enabled = true end
		end
		if npc.rootCollide ~= nil then root.CanCollide = npc.rootCollide end
		hum.AutoRotate = true
		if npc.real and npc.oldNeck ~= nil then
			hum.RequiresNeck = npc.oldNeck
			hum.BreakJointsOnDeath = npc.oldBreak
		end
		hum.PlatformStand = false
		pcall(function() hum.EvaluateStateMachine = true end)

		task.wait(0.1)
		if not model.Parent then
			npc.recovering = false
			return
		end
		for _, part in ipairs(parts) do
			if part.Parent then
				part.Anchored = npc.wasAnchored and npc.wasAnchored[part] or false
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		npc.ragdolled = false
		npc.recovering = false
		npc.hitCooldown = os.clock() + 1.5
	end)
end
Adopt.recover = recoverNpc

local function pushNpc(npc, vel)
	for _, d in ipairs(npc.model:GetDescendants()) do
		if d:IsA("BasePart") then d.AssemblyLinearVelocity += vel end
	end
end

