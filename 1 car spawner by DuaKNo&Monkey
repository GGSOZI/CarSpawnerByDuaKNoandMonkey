--// IMPORTED CAR MODELS (Creator Store assets) ------------------------------------
-- Loads a car model by asset id, strips scripts/joints, lines it up (long axis = Z, front = -Z),
-- scales it to spec.length, finds the wheels so they spin + steer, and plugs it into the same
-- driving physics as the built-in cars. Needs an environment with game:GetObjects (executors).
local assetCache = {}
local lastFetchError = nil

local function fetchAsset(id)
	if assetCache[id] then return assetCache[id] end
	local model
	lastFetchError = nil
	local ok, err = pcall(function()
		local objs = game:GetObjects("rbxassetid://" .. id)
		model = objs and objs[1]
	end)
	if not ok then lastFetchError = tostring(err) end
	if not model then
		local ok2, err2 = pcall(function()
			model = game:GetService("InsertService"):LoadAsset(id)
		end)
		if not ok2 and not lastFetchError then lastFetchError = tostring(err2) end
	end
	if model then
		local kids = model:GetChildren()
		if model:IsA("Model") and #kids == 1 and kids[1]:IsA("Model") and not model.PrimaryPart then
			model = kids[1]
		end
		if not model:IsA("Model") then
			local wrap = Instance.new("Model")
			model.Parent = wrap
			model = wrap
		end
		assetCache[id] = model
	end
	return model
end

local function boundsOfParts(parts, frame)
	local mn, mx
	for _, d in ipairs(parts) do
		local s = d.Size / 2
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					local p = frame:PointToObjectSpace((d.CFrame * CFrame.new(s.X * sx, s.Y * sy, s.Z * sz)).Position)
					mn = mn and mn:Min(p) or p
					mx = mx and mx:Max(p) or p
				end
			end
		end
	end
	return mn, mx
end

local function visibleParts(model)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.95 then table.insert(list, d) end
	end
	return list
end

local function buildImportedCar(spec)
	local tpl = fetchAsset(spec.assetId)
	if not tpl then return nil end
	local model = tpl:Clone()
	model.Name = spec.name

	local partCount = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then partCount += 1 end
	end
	if partCount > MAX_CAR_PARTS then
		model:Destroy()
		notify(spec.name .. " has " .. partCount .. " parts (limit " .. MAX_CAR_PARTS .. ") - skipped to avoid lag")
		return nil
	end

	local junk = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Constraint") or d:IsA("JointInstance") or d:IsA("WeldConstraint")
			or d:IsA("NoCollisionConstraint") or d:IsA("BodyMover") or d:IsA("ProximityPrompt")
			or d:IsA("ClickDetector") or d:IsA("Sound") or d:IsA("Humanoid") or d:IsA("ForceField")
			or d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
			or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") or d:IsA("BillboardGui") then
			table.insert(junk, d)
		elseif d:IsA("Seat") or d:IsA("VehicleSeat") then
			d.Disabled = true
		end
	end
	for _, d in ipairs(junk) do d:Destroy() end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			if d.Size.Magnitude < 2.5 then d.CastShadow = false end
		end
	end

	local vis = visibleParts(model)
	if #vis == 0 then model:Destroy() return nil end
	local P = model:GetPivot()
	local mn, mx = boundsOfParts(vis, P)
	model:PivotTo(CFrame.new(-(mn + mx) / 2))
	local size = mx - mn
	if size.X > size.Z then
		model:PivotTo(CFrame.Angles(0, math.rad(90), 0) * model:GetPivot())
	end
	local frontZ, rearZ, nf, nr = 0, 0, 0, 0
	local FRONT = { "headlight", "headlamp", "hood", "bonnet", "grille", "grill", "front", "bumperf" }
	local REAR = { "taillight", "brakelight", "trunk", "boot", "rear", "back", "exhaust", "spoiler", "wing", "diffuser" }
	local function hasWord(n, list)
		for _, w in ipairs(list) do
			if n:find(w, 1, true) then return true end
		end
		return false
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and math.abs(d.Position.Z) > 0.5 then
			local a, isF, isR = d, false, false
			while a and a ~= model do
				local n = a.Name:lower()
				if not n:find("seat") and not n:find("steer") then
					if hasWord(n, FRONT) then isF = true end
					if hasWord(n, REAR) then isR = true end
				end
				a = a.Parent
			end
			if isF and not isR then frontZ += d.Position.Z nf += 1 end
			if isR and not isF then rearZ += d.Position.Z nr += 1 end
		end
	end
	local score = 0
	if nf > 0 then score += -frontZ / nf end
	if nr > 0 then score += rearZ / nr end
	if nf == 0 and nr == 0 then
		local cz, cn = 0, 0
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Position.Y > -size.Y / 2 + size.Y * 0.6 and d.Transparency < 0.95 then
				cz += d.Position.Z cn += 1
			end
		end
		if cn > 0 then score = cz / cn end
	end
	local flip = score < 0
	if _G.__MonkeyFlips[spec.assetId] then flip = not flip end
	if flip then model:PivotTo(CFrame.Angles(0, math.rad(180), 0) * model:GetPivot()) end
	vis = visibleParts(model)
	mn, mx = boundsOfParts(vis, CFrame.new())
	local factor = (spec.length or 24) / math.max(mx.Z - mn.Z, 0.1)
	model:ScaleTo(model:GetScale() * factor)
	vis = visibleParts(model)
	mn, mx = boundsOfParts(vis, CFrame.new())
	model:PivotTo(CFrame.new(-(mn + mx) / 2) * model:GetPivot())
	mn, mx = boundsOfParts(visibleParts(model), CFrame.new())
	local W, H, L = mx.X - mn.X, mx.Y - mn.Y, mx.Z - mn.Z

	local groups = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local match = false
			local a = d
			while a and a ~= model do
				local n = a.Name:lower()
				if n:find("steer") then match = false break end
				if n:find("wheel") or n:find("tire") or n:find("tyre") or n:find("rim") then match = true end
				a = a.Parent
			end
			local p = d.Position
			if match and p.Y < 0 and math.abs(p.X) > W * 0.25 and math.max(d.Size.X, d.Size.Y, d.Size.Z) < L * 0.3 then
				local key = (p.X < 0 and "L" or "R") .. (p.Z < 0 and "F" or "B")
				groups[key] = groups[key] or { parts = {} }
				table.insert(groups[key].parts, d)
			end
		end
	end

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(W * 0.92, H * 0.55, L * 0.95)
	chassis.Transparency = 1
	chassis.CFrame = CFrame.new()
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.3, 0.1)
	chassis.Parent = model
	model.PrimaryPart = chassis

	local wheelPartSet = {}
	for _, g in pairs(groups) do
		for _, p in ipairs(g.parts) do wheelPartSet[p] = true end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= chassis and not wheelPartSet[d] then
			local w = Instance.new("Weld")
			w.Part0 = chassis
			w.Part1 = d
			w.C0 = chassis.CFrame:ToObjectSpace(d.CFrame)
			w.Parent = d
		end
	end

	local wheels, probe = {}, {}
	local Rsum, Rn = 0, 0
	for _, g in pairs(groups) do
		local gmn, gmx = boundsOfParts(g.parts, CFrame.new())
		local c, sz = (gmn + gmx) / 2, gmx - gmn
		local hub = Instance.new("Part")
		hub.Name = "WheelHub"
		hub.Size = Vector3.new(0.2, 0.2, 0.2)
		hub.Transparency = 1
		hub.CanCollide = false
		hub.CanTouch = false
		hub.CanQuery = false
		hub.Massless = true
		hub.CFrame = CFrame.new(c)
		hub.Parent = model
		local hw = Instance.new("Weld")
		hw.Part0 = chassis
		hw.Part1 = hub
		hw.C0 = CFrame.new(c)
		hw.Parent = hub
		for _, p in ipairs(g.parts) do
			local w = Instance.new("Weld")
			w.Part0 = hub
			w.Part1 = p
			w.C0 = hub.CFrame:ToObjectSpace(p.CFrame)
			w.Parent = p
		end
		table.insert(wheels, { weld = hw, x = c.X, y = c.Y, z = c.Z, front = c.Z < 0, side = c.X < 0 and -1 or 1 })
		table.insert(probe, { x = c.X, z = c.Z })
		Rsum += (sz.Y + sz.Z) / 4
		Rn += 1
	end
	local R = Rn > 0 and Rsum / Rn or H * 0.2
	if #probe < 4 then
		probe = {
			{ x = -W * 0.4, z = -L * 0.31 }, { x = W * 0.4, z = -L * 0.31 },
			{ x = -W * 0.4, z = L * 0.31 }, { x = W * 0.4, z = L * 0.31 },
		}
	end
	local rideH = H / 2

	local function attach(name, offset)
		local a = Instance.new("Attachment")
		a.Name = name
		a.CFrame = offset
		a.Parent = chassis
		return a
	end
	local spots, tailGlows, nitroEmitters = {}, {}, {}
	for _, s in ipairs({ -1, 1 }) do
		local sp = Instance.new("SpotLight")
		sp.Face = Enum.NormalId.Front
		sp.Range = 80
		sp.Angle = 70
		sp.Brightness = 3
		sp.Enabled = false
		sp.Parent = attach("Head", CFrame.new(s * W * 0.32, -H * 0.1, -L / 2))
		table.insert(spots, sp)
		local pl = Instance.new("PointLight")
		pl.Color = C(255, 30, 30)
		pl.Range = 9
		pl.Brightness = 1.6
		pl.Enabled = false
		pl.Parent = attach("Tail", CFrame.new(s * W * 0.32, -H * 0.05, L / 2))
		table.insert(tailGlows, pl)
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(C(190, 230, 255), C(50, 130, 255))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.0), NumberSequenceKeypoint.new(1, 0) })
		e.Lifetime = NumberRange.new(0.18, 0.32)
		e.Speed = NumberRange.new(36, 55)
		e.SpreadAngle = Vector2.new(6, 6)
		e.LightEmission = 1
		e.Rate = 0
		e.EmissionDirection = Enum.NormalId.Back
		e.Parent = attach("Nitro", CFrame.new(s * W * 0.25, -H * 0.2, L / 2 + 0.2))
		table.insert(nitroEmitters, e)
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = spec.name
	prompt.ActionText = "Drive"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = math.max(14, L * 0.7)
	prompt.RequiresLineOfSight = false
	prompt.Parent = chassis

	return {
		model = model, chassis = chassis, spec = spec, prompt = prompt,
		rideH = rideH, wheels = wheels, probe = probe, wheelR = R,
		length = L, width = W, top = H / 2, roofY = H / 2,
		body = spec.color, bodyParts = {},
		headlights = spots, taillights = {}, tailGlows = tailGlows, reverseLights = {},
		signals = { left = {}, right = {} }, siren = nil, glow = nil,
		smokeEmitters = {}, flameEmitters = {}, nitroEmitters = nitroEmitters,
		slipEmitters = {}, trails = {},
		swWeld = nil, swBase = nil,
		seatOffset = CFrame.new(-W * 0.22, -H / 2 + math.clamp(H * 0.55, 2.6, 4.2), -L * 0.02),
		speed = 0, lat = 0, spin = 0, steerIn = 0, normal = Vector3.yAxis,
		wasGrounded = true, lightsOn = false, lightsManual = nil, braking = false, reversing = false,
		nitro = 100, boosting = false, prevThrottle = 0, signal = 0, lastBlink = nil,
		driver = nil, seatWeld = nil, enteredAt = 0,
	}
end

local function buildCar(spec, paintColor)
	local ok, car = pcall(buildImportedCar, spec)
	if ok and car then return car end
	if not ok then warn("[Car Spawner] import failed: " .. tostring(car)) end
	local why = lastFetchError and lastFetchError ~= "" and (": " .. lastFetchError:sub(1, 80))
		or " - this needs an executor that supports game:GetObjects"
	notify("Couldn't load " .. spec.name .. why)
	return nil
end

--// VEHICLE CONTROL ----------------------------------------------------------
local enterCar, exitCar, removeCar, flipCar
local camState = { heading = nil, pos = nil, yaw = 0, pitch = 0, lastLook = 0, scripted = false, baseFov = 70 }

local function keyDown(k)
	return UserInputService:IsKeyDown(k)
end

local function readDriveInput(car, hum)
	local throttle, steer = 0, 0
	local brake, nitro = touch.brake, touch.nitro

	if not UserInputService:GetFocusedTextBox() then
		local f = (keyDown(Enum.KeyCode.W) or keyDown(Enum.KeyCode.Up)) and 1 or 0
		f -= (keyDown(Enum.KeyCode.S) or keyDown(Enum.KeyCode.Down)) and 1 or 0
		local s = (keyDown(Enum.KeyCode.D) or keyDown(Enum.KeyCode.Right)) and 1 or 0
		s -= (keyDown(Enum.KeyCode.A) or keyDown(Enum.KeyCode.Left)) and 1 or 0
		throttle, steer = f, s
		if keyDown(Enum.KeyCode.Space) then brake = true end
		if keyDown(Enum.KeyCode.LeftShift) then nitro = true end

		pcall(function()
			if UserInputService.GamepadEnabled then
				for _, st in ipairs(UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)) do
					if st.KeyCode == Enum.KeyCode.ButtonR2 then
						throttle += st.Position.Z
					elseif st.KeyCode == Enum.KeyCode.ButtonL2 then
						throttle -= st.Position.Z
					end
				end
				if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then brake = true end
				if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonX) then nitro = true end
			end
		end)
		throttle = math.clamp(throttle, -1, 1)
	end

	if throttle == 0 and steer == 0 and hum then
		local md = hum.MoveDirection
		if md.Magnitude > 0.1 then
			local cf = car.chassis.CFrame
			local fl = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
			local rt = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
			if fl.Magnitude > 0.1 and rt.Magnitude > 0.1 then
				throttle = md:Dot(fl.Unit)
				steer = md:Dot(rt.Unit)
			end
		end
	end
	return throttle, steer, brake, nitro
end

local function setLights(car, on)
	if car.lightsOn == on then return end
	car.lightsOn = on
	for _, sp in ipairs(car.headlights) do sp.Enabled = on end
end

local function setTail(car, state)
	if car.tailState == state then return end
	car.tailState = state
	local col = state == 2 and TAIL_ON or (state == 1 and C(205, 22, 22) or TAIL_OFF)
	for _, t in ipairs(car.taillights) do t.Color = col end
	for _, g in ipairs(car.tailGlows) do g.Enabled = state == 2 end
end

local function setReverse(car, on)
	if car.reversing == on then return end
	car.reversing = on
	for _, p in ipairs(car.reverseLights) do p.Color = on and REV_ON or REV_OFF end
end

local function setGlow(car, on)
	local g = car.glow
	if not g or g.on == on then return end
	g.on = on
	g.light.Enabled = on
	for _, p in ipairs(g.parts) do
		p.Transparency = on and 0 or 1
	end
end

local function setSiren(car, on)
	local sr = car.siren
	if not sr then return end
	sr.on = on
	if not on then
		sr.red.Color = C(110, 10, 10)
		sr.blue.Color = C(10, 20, 110)
		sr.rl.Enabled = false
		sr.bl.Enabled = false
		sr.lastPhase = nil
	end
end

local function repaintCar(car, color)
	car.body = color
	for _, p in ipairs(car.bodyParts) do
		if p.Parent then p.Color = color end
	end
end

local function updateCarAudio(car, dt, driven, throttle, slip, boosting)
	local a = car.audio
	if not a then
		if not driven then return end
		a = { rpm = 0.2 }
		local snd = Instance.new("Sound")
		snd.SoundId = ENGINE_LOOP_ID
		snd.Looped = true
		snd.Volume = 0
		snd.RollOffMode = Enum.RollOffMode.InverseTapered
		snd.RollOffMinDistance = 14
		snd.RollOffMaxDistance = 260
		snd.Parent = car.chassis
		pcall(function() snd:Play() end)
		a.engine = snd
		car.audio = a
	end
	local snd = a.engine
	if not (driven and settings.sounds) then
		snd.Volume = 0
		return
	end
	if not snd.IsPlaying then pcall(function() snd:Play() end) end
	local maxSpd = car.spec.maxSpeed * settings.speedMult
	local ratio = math.clamp(math.abs(car.speed) / maxSpd, 0, 1.4)
	local band = (ratio * 6) % 1
	if ratio >= 1 then band = 1 end
	a.rpm += ((0.2 + band * 0.8) - a.rpm) * math.clamp(dt * 8, 0, 1)
	snd.PlaybackSpeed = 0.7 + a.rpm * 0.8
	snd.Volume = (0.2 + 0.6 * a.rpm * (0.45 + 0.55 * math.abs(throttle))) * settings.volume
end

local function parkCar(car)
	car.parked = true
	for _, e in ipairs(car.nitroEmitters) do e.Rate = 0 end
	for _, e in ipairs(car.slipEmitters) do e.Rate = 0 end
	for _, t in ipairs(car.trails) do t.Enabled = false end
	car.chassis.AssemblyLinearVelocity = Vector3.zero
	car.chassis.AssemblyAngularVelocity = Vector3.zero
	car.chassis.Anchored = true
end

-- Pushes loose (unanchored) parts out of the way. Works on parts your own client is simulating
-- (normally the ones near you); parts the server is simulating can't be moved from here.
local Push = { params = OverlapParams.new() }
Push.params.FilterType = Enum.RaycastFilterType.Exclude
Push.params.MaxParts = 60

function Push.run(car, dt, cf, speed, fwd)
	if math.abs(speed) < 3 then return end
	car.pushAcc = (car.pushAcc or 0) + dt
	if car.pushAcc < (settings.lowLag and 0.1 or 0.033) then return end
	car.pushAcc = 0
	local sign = speed >= 0 and 1 or -1
	local dir = fwd * sign
	local center = cf * CFrame.new(0, 0, -sign * (car.length / 2 + 1.5))
	local filter = { world }
	if player.Character then table.insert(filter, player.Character) end
	Push.params.FilterDescendantsInstances = filter
	local parts = Workspace:GetPartBoundsInBox(center, Vector3.new(car.width + 1, car.top * 1.8, 4), Push.params)
	local want = math.abs(speed) * 1.05
	local seen = {}
	for _, p in ipairs(parts) do
		if not p.Anchored and p.CanCollide then
			local r = p.AssemblyRootPart
			if r and not r.Anchored and not seen[r] then
				seen[r] = true
				local m = p:FindFirstAncestorOfClass("Model")
				if not (m and m:FindFirstChildOfClass("Humanoid")) and not p:FindFirstAncestorOfClass("Tool")
					and not p:FindFirstAncestorOfClass("Accessory") then
					local v = r.AssemblyLinearVelocity
					local cur = v:Dot(dir)
					if cur < want then
						r.AssemblyLinearVelocity = v + dir * (want - cur)
					end
				end
			end
		end
	end
end

local function stepCar(car, dt, now, hum)
	local chassis = car.chassis
	local spec = car.spec
	local cf = chassis.CFrame
	local vel = chassis.AssemblyLinearVelocity
	local driven = (car == drivenCar)

	local throttle, steer, handbrake, nitroKey = 0, 0, false, false
	if driven then
		throttle, steer, handbrake, nitroKey = readDriveInput(car, hum)
	end

	local down = Vector3.new(0, -(car.rideH + 4), 0)
	local pts, dists = {}, {}
	local hits, sumDist = 0, 0
	for i, pr in ipairs(car.probe) do
		local o = cf:PointToWorldSpace(Vector3.new(pr.x, 0, pr.z))
		local r = Workspace:Raycast(o, down, rayParams)
		if r then
			hits += 1
			pts[i] = r.Position
			dists[i] = o.Y - r.Position.Y
			sumDist += dists[i]
		end
	end

	local grounded, dist, n = false, 0, Vector3.yAxis
	if hits > 0 then
		grounded = true
		dist = (sumDist / hits) * math.clamp(car.normal.Y, 0.3, 1)
		local nn
		if hits == 4 then
			nn = (pts[2] - pts[3]):Cross(pts[1] - pts[4])
		elseif hits == 3 then
			local idx = {}
			for i = 1, 4 do
				if pts[i] then table.insert(idx, i) end
			end
			nn = (pts[idx[2]] - pts[idx[1]]):Cross(pts[idx[3]] - pts[idx[1]])
		end
		if nn and nn.Magnitude > 0.1 then
			nn = nn.Unit
			if nn.Y < 0 then nn = -nn end
			if nn.Y > 0.5 then n = nn end
		end
	end
	if dist > car.rideH + (car.wasGrounded and 3.2 or 1.5) then grounded = false end
	if cf.UpVector.Y < 0.15 then grounded = false end

	car.normal = car.normal:Lerp(n, math.clamp(dt * 8, 0, 1))
	if car.normal.Magnitude < 0.1 then
		car.normal = Vector3.yAxis
	else
		car.normal = car.normal.Unit
	end
	local nrm = car.normal

	local fwd = cf.LookVector - nrm * cf.LookVector:Dot(nrm)
	if fwd.Magnitude < 0.1 then
		fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	end
	if fwd.Magnitude < 0.1 then
		fwd = Vector3.new(0, 0, -1)
	end
	fwd = fwd.Unit
	local right = fwd:Cross(nrm)
	if right.Magnitude < 0.1 then right = cf.RightVector else right = right.Unit end

	local vTan = vel - nrm * vel:Dot(nrm)
	local actualF = vTan:Dot(fwd)
	local actualR = vTan:Dot(right)
	if grounded then
		if not car.wasGrounded then
			car.speed = actualF
		elseif math.abs(actualF) < math.abs(car.speed) - 30 then
			car.speed = actualF
		end
	end
	car.wasGrounded = grounded

	local maxSpd = spec.maxSpeed * settings.speedMult
	local accelMul = 1
	local boosting = false
	if driven and nitroKey and car.nitro > 1 and throttle > 0.05 then
		boosting = true
		maxSpd *= 1.45
		accelMul = 2.4
		car.nitro = math.max(0, car.nitro - 30 * dt)
	else
		car.nitro = math.min(100, car.nitro + (driven and 5 or 12) * dt)
	end
	car.boosting = boosting

	local target = 0
	if throttle > 0.05 then
		target = throttle * maxSpd
	elseif throttle < -0.05 then
		target = throttle * maxSpd * 0.35
	end
	local rate
	if driven and handbrake then
		target = throttle > 0.05 and target * 0.5 or 0
		rate = 1.3
	elseif driven and math.abs(throttle) > 0.05 then
		rate = (car.speed * throttle < 0) and 3.0 or spec.accel * accelMul
	else
		rate = driven and 0.45 or 1.6
	end
	car.speed += (target - car.speed) * math.clamp(rate * dt, 0, 1)

	car.steerIn += (steer - car.steerIn) * math.clamp(dt * 9, 0, 1)
	local absSpd = math.abs(car.speed)
	local sf = math.clamp(absSpd / 18, 0, 1) * (1 - 0.35 * math.clamp(absSpd / math.max(maxSpd, 1), 0, 1))
	local dir = car.speed >= 0 and 1 or -1
	local yaw = -car.steerIn * spec.turn * sf * dir * ((driven and handbrake) and 1.5 or 1)

	local gripBase = 7 * settings.grip
	local grip = gripBase
	if driven and handbrake and absSpd > 15 then grip = gripBase * 0.12 end
	if absSpd < 8 then grip = math.max(grip, 10) end
	local lat = actualR * math.exp(-grip * dt)
	car.lat = lat
	car.speed -= math.sign(car.speed) * math.min(math.abs(lat), 40) * 0.35 * dt

	local slip = grounded and driven and (math.abs(lat) > 9
		or (handbrake and absSpd > 18)
		or (throttle > 0.9 and car.speed > 0 and absSpd < 10 and spec.accel >= 1.4))

	if grounded then
		local vnTarget = math.clamp((car.rideH - dist) * 10 + Workspace.Gravity * dt * 0.5, -18, 14)
		car.vn = (car.vn or 0) + (vnTarget - (car.vn or 0)) * math.clamp(dt * 40, 0, 1)
		chassis.AssemblyLinearVelocity = fwd * car.speed + right * lat + nrm * car.vn
		local tilt = cf.UpVector:Cross(nrm) * 12
		chassis.AssemblyAngularVelocity = tilt + nrm * yaw
		Push.run(car, dt, cf, car.speed, fwd)
	else
		local tilt = cf.UpVector:Cross(Vector3.yAxis) * 3
		chassis.AssemblyAngularVelocity = chassis.AssemblyAngularVelocity * (1 - math.clamp(dt * 2, 0, 1)) + tilt * dt * 5
	end

	if driven then
		if cf.UpVector.Y < 0.25 then
			car.flipTimer = (car.flipTimer or 0) + dt
			if car.flipTimer > 2.5 then
				car.flipTimer = 0
				flipCar(car)
				notify("Flipped back upright")
			end
		else
			car.flipTimer = 0
		end
	end

	car.spin -= car.speed / car.wheelR * dt
	local steerCF = CFrame.Angles(0, -car.steerIn * 0.5, 0)
	local spinCF = CFrame.Angles(car.spin, 0, 0)
	local w0 = car.wheelR - car.rideH
	for i, w in ipairs(car.wheels) do
		local d = dists[i]
		local ty = grounded and w.y or (w0 - 0.5)
		if d then ty = math.clamp(car.wheelR - d, w0 - 0.5, w0 + 0.7) end
		w.y += (ty - w.y) * math.clamp(dt * 14, 0, 1)
		local base = CFrame.new(w.x, w.y, w.z)
		if w.front then
			w.weld.C0 = base * steerCF * spinCF
		else
			w.weld.C0 = base * spinCF
		end
	end
	if car.swWeld then
		car.swWeld.C0 = car.swBase * CFrame.Angles(car.steerIn * 2.4, 0, 0)
	end

	local wantLights
	if car.lightsManual ~= nil then wantLights = car.lightsManual else wantLights = driven and settings.autoLights end
	setLights(car, wantLights and true or false)
	local braking = driven and ((throttle * car.speed < -1) or handbrake)
	setTail(car, braking and 2 or (wantLights and 1 or 0))
	setReverse(car, driven and car.speed < -1 and throttle < -0.05)

	local sig = car.signal
	local blinkOn = sig ~= 0 and (math.floor(now * 2.6) % 2 == 0)
	if car.lastBlink ~= blinkOn or car.lastSig ~= sig then
		car.lastBlink, car.lastSig = blinkOn, sig
		local lOn = blinkOn and (sig == -1 or sig == 2)
		local rOn = blinkOn and (sig == 1 or sig == 2)
		for _, p in ipairs(car.signals.left) do p.Color = lOn and IND_ON or IND_OFF end
		for _, p in ipairs(car.signals.right) do p.Color = rOn and IND_ON or IND_OFF end
	end

	local sr = car.siren
	if sr and sr.on then
		local ph = math.floor(now * 8) % 8
		if sr.lastPhase ~= ph then
			sr.lastPhase = ph
			local redOn = (ph == 0 or ph == 2)
			local blueOn = (ph == 4 or ph == 6)
			sr.red.Color = redOn and C(255, 30, 30) or C(110, 10, 10)
			sr.blue.Color = blueOn and C(50, 90, 255) or C(10, 20, 110)
			sr.rl.Enabled = redOn
			sr.bl.Enabled = blueOn
		end
	end

	if car.glow then
		local want
		if car.glowManual ~= nil then want = car.glowManual else want = settings.underglow end
		setGlow(car, want and true or false)
	end

	local smokeRate = 0
	if settings.smoke and not settings.lowLag and driven then
		smokeRate = 3 + ((absSpd > 3) and math.abs(throttle) * 12 or 0)
	end
	if car.lastSmoke ~= smokeRate then
		car.lastSmoke = smokeRate
		for _, e in ipairs(car.smokeEmitters) do e.Rate = smokeRate end
	end
	local boostRate = boosting and 140 or 0
	if car.lastBoost ~= boostRate then
		car.lastBoost = boostRate
		for _, e in ipairs(car.nitroEmitters) do e.Rate = boostRate end
	end
	if driven and car.prevThrottle > 0.6 and throttle < 0.2 and car.speed > maxSpd * 0.55 then
		for _, e in ipairs(car.flameEmitters) do e:Emit(8) end
	end
	car.prevThrottle = throttle
	updateCarAudio(car, dt, driven, throttle, slip and true or false, boosting and true or false)

	local slipRate = (slip and settings.smoke and not settings.lowLag) and 55 or 0
	if car.lastSlip ~= slipRate then
		car.lastSlip = slipRate
		for _, e in ipairs(car.slipEmitters) do e.Rate = slipRate end
	end
	local skid = (slip and settings.skidMarks and not settings.lowLag) and true or false
	for _, t in ipairs(car.trails) do
		if t.Enabled ~= skid then t.Enabled = skid end
	end

	if not driven then
		if grounded and absSpd < 0.4 and math.abs(lat) < 0.4 then
			car.idleT = (car.idleT or 0) + dt
			if car.idleT > 0.6 then parkCar(car) end
		else
			car.idleT = 0
		end
	end
end

removeCar = function(car)
	if car.driver then exitCar(car, true) end
	local i = table.find(cars, car)
	if i then table.remove(cars, i) end
	if car.model then car.model:Destroy() end
end

flipCar = function(car)
	car = car or drivenCar or cars[#cars]
	if not car or not car.chassis.Parent then return end
	local cf = car.chassis.CFrame
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
	local p = cf.Position + Vector3.new(0, car.rideH + 3, 0)
	car.parked, car.idleT = false, 0
	car.chassis.Anchored = false
	car.model:PivotTo(CFrame.lookAt(p, p + look.Unit))
	car.chassis.AssemblyLinearVelocity = Vector3.zero
	car.chassis.AssemblyAngularVelocity = Vector3.zero
	car.speed, car.lat = 0, 0
end

local function restoreCamera()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	cam.FieldOfView = camState.baseFov
	if camState.scripted then
		camState.scripted = false
		cam.CameraType = Enum.CameraType.Custom
		local _, hum = getCharacter()
		if hum then cam.CameraSubject = hum end
	end
end

enterCar = function(car)
	if not car or not car.chassis.Parent then return end
	if drivenCar == car then return end
	local char, hum, root = getCharacter()
	if not char then
		notify("No character found.")
		return
	end
	if drivenCar then
		exitCar(drivenCar, true)
		char, hum, root = getCharacter()
		if not char then return end
	end
	if car.driver then return end

	car.driver = { char = char, hum = hum, root = root }
	car.enteredAt = os.clock()
	car.prompt.Enabled = false
	car.parked, car.idleT = false, 0
	car.chassis.Anchored = false
	drivenCar = car
	Net.apply()

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = car.chassis.CFrame * car.seatOffset
	car.driverCollide = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			car.driverCollide[d] = true
			d.CanCollide = false
		end
	end
	hum.Sit = true
	hum:ChangeState(Enum.HumanoidStateType.Seated)

	pcall(function()
		ContextActionService:BindActionAtPriority("MonkeyDriveSink", function()
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 10, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	end)

	local cam = Workspace.CurrentCamera
	if cam then camState.baseFov = cam.FieldOfView end
	camState.heading, camState.pos, camState.yaw, camState.pitch = nil, nil, 0, 0

	notify(car.spec.name .. " - F to exit, Shift = nitro, Space = handbrake")
end

exitCar = function(car, silent)
	if not car or not car.driver then return end
	local d = car.driver
	car.driver = nil
	if drivenCar == car then drivenCar = nil end
	Net.restore()
	pcall(function() ContextActionService:UnbindAction("MonkeyDriveSink") end)
	if car.seatWeld then
		car.seatWeld:Destroy()
		car.seatWeld = nil
	end
	if car.prompt and car.prompt.Parent then car.prompt.Enabled = true end
	touch.nitro, touch.brake = false, false
	restoreCamera()

	if car.driverCollide then
		for part in pairs(car.driverCollide) do
			if part.Parent then part.CanCollide = true end
		end
		car.driverCollide = nil
	end
	local hum, root = d.hum, d.root
	if hum and hum.Parent then hum.Sit = false end
	if root and root.Parent and car.chassis.Parent and hum and hum.Health > 0 then
		local cf = car.chassis.CFrame
		local pos = cf.Position - cf.RightVector * (car.width / 2 + 3.5)
		local hit = groundBelow(pos + Vector3.new(0, 10, 0), { d.char, world })
		local gy = hit and hit.Position.Y or (cf.Position.Y - car.rideH)
		local standY = gy + hum.HipHeight + root.Size.Y / 2 + 0.5
		local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
		local p = Vector3.new(pos.X, standY, pos.Z)
		root.CFrame = CFrame.lookAt(p, p + look.Unit)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	if not silent then notify("Exited " .. car.spec.name) end
end

local function nearestCar(maxDist)
	local _, _, root = getCharacter()
	local refPos = root and root.Position
	if not refPos then return nil end
	local best, bestD = nil, maxDist or math.huge
	for _, car in ipairs(cars) do
		if car.chassis.Parent and not car.driver then
			local d = (car.chassis.Position - refPos).Magnitude
			if d < bestD then best, bestD = car, d end
		end
	end
	return best
end

local function spawnVehicle(spec)
	local char, hum, root = getCharacter()
	if not char then
		notify("No character found.")
		return
	end
	if drivenCar then
		exitCar(drivenCar, true)
		char, hum, root = getCharacter()
		if not char then return end
	end
	while #cars >= settings.maxVehicles do
		removeCar(cars[1])
	end

	if spec.assetId and not assetCache[spec.assetId] then notify("Loading " .. spec.name .. "...") end
	local car = buildCar(spec, settings.paint)
	if not car then return end
	local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if forward.Magnitude < 0.1 then forward = Vector3.new(0, 0, -1) end
	forward = forward.Unit

	local pos = root.Position + forward * (spec.length * 0.5 + 8)
	local hit = groundBelow(Vector3.new(pos.X, root.Position.Y + 10, pos.Z), { char, world })
	local gy = hit and hit.Position.Y or (root.Position.Y - 3)
	local p = Vector3.new(pos.X, gy + car.rideH + 0.3, pos.Z)

	car.model:PivotTo(CFrame.lookAt(p, p + forward))
	car.model.Parent = carFolder
	table.insert(cars, car)

	car.prompt.Triggered:Connect(function()
		enterCar(car)
	end)

	if settings.autoEnter then
		task.defer(function()
			task.wait(0.1)
			if car.model.Parent then enterCar(car) end
		end)
		notify(spec.name .. " spawned")
	else
		notify(spec.name .. " spawned - walk up and press E")
	end
end

local function removeAllCars()
	for i = #cars, 1, -1 do
		removeCar(cars[i])
	end
	notify("Vehicles removed")
end

--// CHASE CAMERA ------------------------------------------------------------
local function updateCamera(dt)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local car = drivenCar
	if car and car.chassis.Parent then
		local cf = car.chassis.CFrame
		local spdRatio = math.clamp(math.abs(car.speed) / (car.spec.maxSpeed * settings.speedMult), 0, 1.5)

		if settings.chaseCam then
			if cam.CameraType ~= Enum.CameraType.Scriptable then
				cam.CameraType = Enum.CameraType.Scriptable
				camState.scripted = true
			end
			local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
			if look.Magnitude < 0.1 then look = camState.heading or Vector3.new(0, 0, -1) end
			look = look.Unit
			if camState.heading then
				camState.heading = camState.heading:Lerp(look, math.clamp(dt * 4.5, 0, 1))
			else
				camState.heading = look
			end
			if camState.heading.Magnitude < 0.1 then camState.heading = look end
			local hv = camState.heading.Unit

			if os.clock() - camState.lastLook > 1.8 then
				local k = 1 - math.clamp(dt * 3, 0, 1)
				camState.yaw *= k
				camState.pitch *= k
			end
			local dirv = CFrame.Angles(0, camState.yaw, 0):VectorToWorldSpace(hv)
			local big = car.spec.monster and 8 or 0
			local dist = car.length * 0.5 + 11 + spdRatio * 4 + big
			local focus = cf.Position + Vector3.new(0, car.top + 2.6, 0)
			local desired = focus - dirv * dist + Vector3.new(0, 3.5 + dist * 0.12 + camState.pitch * 14 + big * 0.4, 0)
			local ray = Workspace:Raycast(focus, desired - focus, rayParams)
			if ray then desired = ray.Position + ray.Normal * 0.7 end
			if camState.pos then
				camState.pos = camState.pos:Lerp(desired, 1 - math.exp(-dt * 14))
			else
				camState.pos = desired
			end
			cam.CFrame = CFrame.lookAt(camState.pos, focus)
			cam.Focus = CFrame.new(focus)
		elseif camState.scripted then
			camState.scripted = false
			cam.CameraType = Enum.CameraType.Custom
			local _, hum = getCharacter()
			if hum then cam.CameraSubject = hum end
		end

		if settings.fovEffect then
			local target = camState.baseFov + spdRatio * 16 + (car.boosting and 10 or 0)
			cam.FieldOfView += (target - cam.FieldOfView) * math.clamp(dt * 5, 0, 1)
		elseif cam.FieldOfView ~= camState.baseFov then
			cam.FieldOfView = camState.baseFov
		end
	end

end

--// CAR SEARCH (Creator Store) -----------------------------------------------
-- Talks to the same service the Creator Store website uses, through your executor's HTTP function.
-- Roblox blocks HttpService on roblox.com, so this needs request / http_request / syn.request.
-- If the store can't be reached, "Spawn by asset ID" on the Cars tab still works.
local Search = {
	query = "", page = 0, results = {}, seen = {}, busy = false, hasMore = false,
	status = "Type a car name and press Search.",
}
local Saved = { list = {} }
local spawning = false

local CAR_WORDS = {
	"car", "cars", "truck", "vehicle", "bus", "van", "suv", "jeep", "taxi", "sedan", "coupe", "supercar",
	"pickup", "limo", "hatchback", "muscle", "racecar", "ambulance", "tank",
}

local function httpGet(url)
	local req = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and syn.request)
		or (typeof(http) == "table" and http.request)
		or (typeof(fluxus) == "table" and fluxus.request)
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
		if not ok then return nil, tostring(res) end
		if type(res) ~= "table" then return nil, "bad response" end
		local code = res.StatusCode or res.status_code or 0
		if res.Success == false or (type(code) == "number" and code >= 400) then
			return nil, "HTTP " .. tostring(code)
		end
		return res.Body or res.body
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" then return body end
	return nil, "this executor has no HTTP request function"
end

local function buildQuery(q)
	if settings.carsOnly then
		local low = " " .. q:lower() .. " "
		for _, w in ipairs(CAR_WORDS) do
			if low:find("%f[%w]" .. w .. "%f[%W]") then return q end
		end
		return q .. " car"
	end
	return q
end

function Search.setStatus(text)
	Search.status = text
	if UI.setSearchStatus then UI.setSearchStatus(text) end
end

function Search.run(query, page)
	if Search.busy then return end
	query = (query or ""):match("^%s*(.-)%s*$")
	if query == "" then
		Search.setStatus("Type something to search for first.")
		return
	end
	page = page or 0
	Search.busy = true
	if page == 0 then
		Search.query = query
		Search.results = {}
		Search.seen = {}
		Search.hasMore = false
		if UI.renderResults then UI.renderResults() end
	end
	Search.setStatus("Searching for '" .. query .. "'...")

	task.spawn(function()
		local ok, err = pcall(function()
			local url = string.format("%s/marketplace/%d?limit=%d&pageNumber=%d&keyword=%s",
				STORE_API, STORE_MODEL_TYPE, STORE_PAGE_SIZE, page, HttpService:UrlEncode(buildQuery(Search.query)))
			local body, e = httpGet(url)
			if not body then error(e or "no response", 0) end
			local data = HttpService:JSONDecode(body)
			local rows = type(data) == "table" and data.data or nil
			if type(rows) ~= "table" then error("unexpected reply from the store", 0) end

			local ids = {}
			for _, row in ipairs(rows) do
				local id = row.id or row.assetId or (type(row.asset) == "table" and row.asset.id)
				if id and not Search.seen[id] then
					Search.seen[id] = true
					table.insert(ids, id)
				end
			end
			Search.hasMore = #rows >= STORE_PAGE_SIZE
			Search.page = page

			local info = {}
			if #ids > 0 then
				local b2 = httpGet(STORE_API .. "/items/details?assetIds=" .. table.concat(ids, ","))
				if b2 then
					local ok2, d2 = pcall(function() return HttpService:JSONDecode(b2) end)
					if ok2 and type(d2) == "table" and type(d2.data) == "table" then
						for _, item in ipairs(d2.data) do
							local a = type(item.asset) == "table" and item.asset or item
							if a.id then info[a.id] = item end
						end
					end
				end
			end
			for _, id in ipairs(ids) do
				local item = info[id]
				local a = item and (type(item.asset) == "table" and item.asset or item) or {}
				local v = item and type(item.voting) == "table" and item.voting or {}
				local up, down = tonumber(v.upVotes) or 0, tonumber(v.downVotes) or 0
				table.insert(Search.results, {
					id = id,
					name = a.name or ("Model " .. tostring(id)),
					creator = item and type(item.creator) == "table" and item.creator.name or "unknown",
					score = (up + down > 0) and (up / (up + down)) or nil,
					votes = up + down,
					scripts = a.hasScripts and true or false,
				})
			end
		end)
		Search.busy = false
		if ok then
			if #Search.results == 0 then
				Search.setStatus("No results for '" .. Search.query .. "'. Try another word.")
			else
				Search.setStatus(#Search.results .. " results for '" .. Search.query .. "'")
			end
		else
			local msg = tostring(err)
			if msg:find("40[13]") then
				msg = msg .. " (the store refused the request - use Spawn by asset ID instead)"
			end
			Search.setStatus("Search failed: " .. msg:sub(1, 140))
		end
		if UI.renderResults then UI.renderResults() end
	end)
end

function Search.more()
	if Search.hasMore and not Search.busy then Search.run(Search.query, Search.page + 1) end
end

--// SAVED CARS (favourites) ---------------------------------------------------
do
	local loaded = _G.__MonkeySaved
	if type(loaded) ~= "table" then
		loaded = nil
		pcall(function()
			if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(SAVE_FILE) then
				local d = HttpService:JSONDecode(readfile(SAVE_FILE))
				if type(d) == "table" then loaded = d end
			end
		end)
	end
	Saved.list = loaded or {}
	_G.__MonkeySaved = Saved.list
end

function Saved.persist()
	pcall(function()
		if typeof(writefile) == "function" then
			writefile(SAVE_FILE, HttpService:JSONEncode(Saved.list))
		end
	end)
end

function Saved.has(id)
	for _, e in ipairs(Saved.list) do
		if e.id == id then return true end
	end
	return false
end

function Saved.add(id, name)
	if Saved.has(id) then return end
	table.insert(Saved.list, { id = id, name = name or ("Model " .. tostring(id)) })
	Saved.persist()
	if UI.renderSaved then UI.renderSaved() end
end

function Saved.remove(id)
	for i, e in ipairs(Saved.list) do
		if e.id == id then
			table.remove(Saved.list, i)
			break
		end
	end
	Saved.persist()
	if UI.renderSaved then UI.renderSaved() end
end

