local function regionOf(part)
	local n = part.Name
	if n == "Head" then return "head" end
	if part.Parent and part.Parent:IsA("Accessory") then
		local att = part:FindFirstChildOfClass("Attachment")
		if att and (att.Name:find("Hat") or att.Name:find("Hair") or att.Name:find("Face")) then return "head" end
		return "torso"
	end
	if n:find("Arm") or n:find("Hand") then return "arm" end
	if n:find("Leg") or n:find("Foot") then return "leg" end
	return "torso"
end

local function killNpc(npc)
	pcall(function()
		for _, d in ipairs(npc.model:GetDescendants()) do
			if d:IsA("Humanoid") then d.Health = 0 end
		end
	end)
end

local function damageNpc(npc, part, amount, dir, hitPos, force, cause)
	local now = os.clock()
	force = force or Vector3.zero
	local region = (cause == "car") and "torso" or regionOf(part)

	if npc.dead then
		pushNpc(npc, force * 0.4)
		return true, false
	end

	npc.hp -= amount
	local killed = npc.hp <= 0
	local fresh = not npc.ragdolled

	if killed and npc.real then
		npc.dead = true
		npc.deadAt = now
		npc.recoverAt = math.huge
		killNpc(npc)
		if not npc.realKilled then
			npc.realKilled = true
			Net.kill(npc)
		end
		playSound(SOUNDS.pain, npc.root, 0.8)
		return true, true
	end

	if killed then
		npc.dead = true
		npc.deadAt = now
		npc.recoverAt = math.huge
	else
		npc.recoverAt = now + (region == "leg" and 6.5 or 4.5)
	end

	if fresh then
		ragdoll(npc, force)
	else
		pushNpc(npc, force * 0.5)
	end
	if killed then killNpc(npc) end
	task.delay(0.06, function()
		if part.Parent then
			pcall(function()
				part:ApplyImpulseAtPosition(dir * part.AssemblyMass * 16, hitPos)
			end)
		end
	end)

	say(npc, pick(cause == "car" and PAIN_LINES.car or PAIN_LINES[region]))
	playSound(SOUNDS.pain, npc.root, 0.8)

	if killed then
		task.delay(1.3, function()
			if npc.model and npc.model.Parent then say(npc, pick(PAIN_LINES.dying)) end
		end)
	end
	return true, killed
end

local function alertBubble(npc, now)
	if now < npc.alertAt then return end
	npc.alertAt = now + 3
	say(npc, pick(PAIN_LINES.scared))
end

local function stepNpc(npc, dt, now)
	local hum, root = npc.humanoid, npc.root
	if not (hum and hum.Parent and root and root.Parent and npc.model.Parent) then return false end
	if root.Position.Y < -300 then return false end
	if npc.real and not npc.dead and hum.Health <= 0 then return false end
	if npc.real and npc.dead and not npc.ragdolled then return false end

	if npc.ragdolled then
		if npc.dead then
			return now <= npc.deadAt + 8
		end
		if now >= npc.recoverAt then recoverNpc(npc) end
		return true
	end

	local pos = root.Position
	local alert = false

	for _, car in ipairs(cars) do
		local cc = car.chassis
		if cc.Parent then
			local cf = cc.CFrame
			local v = cc.AssemblyLinearVelocity
			local flatV = Vector3.new(v.X, 0, v.Z)
			local spd = flatV.Magnitude

			local rel = cf:PointToObjectSpace(pos)
			if spd > 9 and now > npc.hitCooldown
				and math.abs(rel.X) < car.width / 2 + 1.4
				and math.abs(rel.Z) < car.length / 2 + 2.5
				and math.abs(rel.Y) < car.rideH + 3 then
				npc.hitCooldown = now + 1.5
				local f = spd > 0.1 and flatV.Unit or cf.LookVector
				local side = cf.RightVector * (math.random() * 2 - 1) * 25
				local launch = f * math.clamp(spd * 0.9, 20, 120) + side + Vector3.new(0, math.clamp(20 + spd * 0.35, 25, 55), 0)
				damageNpc(npc, root, 1e6, launch.Unit, pos, launch, "car")
				return true
			end

			local toNpc = Vector3.new(pos.X - cf.Position.X, 0, pos.Z - cf.Position.Z)
			local d = toNpc.Magnitude
			if d < 22 + spd * 0.7 and d > 0.1 and math.abs(pos.Y - cf.Position.Y) < car.rideH + 8 then
				if (spd > 4 and flatV:Dot(toNpc) > 0) or (spd > 2 and d < 10) then
					alert = true
				end
			end
		end
	end
	if alert then alertBubble(npc, now) end

	if not npc.real then setAnim(npc, "idle") end
	return true
end

