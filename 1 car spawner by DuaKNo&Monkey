track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	local kc = input.KeyCode

	if kc == Enum.KeyCode.M then
		UI.togglePanel()
		return
	elseif kc == Enum.KeyCode.V then
		flipCar()
		return
	elseif kc == Enum.KeyCode.C then
		settings.chaseCam = not settings.chaseCam
		UI.refresh()
		notify(settings.chaseCam and "Chase camera on" or "Chase camera off")
		return
	end

	local car = drivenCar
	if not car then return end
	if kc == Enum.KeyCode.F or kc == Enum.KeyCode.ButtonB then
		exitCar(car)
	elseif kc == Enum.KeyCode.L then
		car.lightsManual = not car.lightsOn
	elseif kc == Enum.KeyCode.H then
		playSound(SOUNDS.horn, car.chassis)
	elseif kc == Enum.KeyCode.G then
		if car.siren then
			setSiren(car, not car.siren.on)
			notify(car.siren.on and "Siren on" or "Siren off")
		elseif car.glow then
			local cur = car.glow.on
			car.glowManual = not cur
			notify(car.glowManual and "Underglow on" or "Underglow off")
		else
			notify("This car has no siren or underglow")
		end
	elseif kc == Enum.KeyCode.Q then
		car.signal = (car.signal == -1) and 0 or -1
	elseif kc == Enum.KeyCode.E then
		car.signal = (car.signal == 1) and 0 or 1
	elseif kc == Enum.KeyCode.Z then
		car.signal = (car.signal == 2) and 0 or 2
	end
end))

track(UserInputService.InputChanged:Connect(function(input, processed)
	if drivenCar and not processed and input.UserInputType == Enum.UserInputType.Touch then
		camState.yaw -= input.Delta.X * 0.009
		camState.pitch = math.clamp(camState.pitch + input.Delta.Y * 0.006, -0.4, 0.9)
		camState.lastLook = os.clock()
		return
	end
	if drivenCar and input.KeyCode == Enum.KeyCode.Thumbstick2 then
		camState.yaw -= input.Position.X * 0.05
		camState.pitch = math.clamp(camState.pitch - input.Position.Y * 0.03, -0.4, 0.9)
		camState.lastLook = os.clock()
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement and drivenCar
		and (UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then
		camState.yaw -= input.Delta.X * 0.006
		camState.pitch = math.clamp(camState.pitch + input.Delta.Y * 0.004, -0.4, 0.9)
		camState.lastLook = os.clock()
	end
end))

