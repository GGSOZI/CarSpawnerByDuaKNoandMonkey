local driverParts, driverPartsAt, driverPartsChar = {}, 0, nil
track(RunService.Stepped:Connect(function()
	local car = drivenCar
	local d = car and car.driver
	if not (d and d.char and d.char.Parent) then
		driverParts, driverPartsChar = {}, nil
		return
	end
	local now = os.clock()
	if driverPartsChar ~= d.char or now - driverPartsAt > 0.5 then
		driverPartsChar, driverPartsAt = d.char, now
		driverParts = {}
		for _, p in ipairs(d.char:GetDescendants()) do
			if p:IsA("BasePart") then driverParts[#driverParts + 1] = p end
		end
	end
	for i = 1, #driverParts do
		local p = driverParts[i]
		if p.CanCollide then p.CanCollide = false end
	end
end))

track(RunService.Heartbeat:Connect(function(dt)
	perf.dt = perf.dt * 0.95 + dt * 0.05
	dt = math.min(dt, 0.1)
	local now = os.clock()
	local char, hum, root = getCharacter()
	playerRoot = root

	if char ~= lastChar then
		lastChar = char
		rayParams.FilterDescendantsInstances = char and { world, char } or { world }
	end

	if drivenCar then
		local d = drivenCar.driver
		if not char or not d or d.char ~= char then
			exitCar(drivenCar, true)
		elseif now - drivenCar.enteredAt < 0.6 then
			if not hum.Sit then hum.Sit = true end
		elseif not hum.Sit then
			exitCar(drivenCar)
		end
	end

	for i = #cars, 1, -1 do
		local car = cars[i]
		if not car.model.Parent then
			if car.driver then exitCar(car, true) end
			table.remove(cars, i)
		elseif car.chassis.Position.Y < -250 then
			removeCar(car)
			notify("A vehicle fell out of the world")
		elseif not car.parked then
			stepCar(car, dt, now, hum)
		end
	end

	if drivenCar and drivenCar.driver and root and drivenCar.chassis.Parent then
		local ch = drivenCar.chassis
		root.CFrame = ch.CFrame * drivenCar.seatOffset
		root.AssemblyLinearVelocity = ch.AssemblyLinearVelocity
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local npcStep = settings.lowLag and NPC_STEP_LOW or NPC_STEP
	for i = #npcs, 1, -1 do
		local npc = npcs[i]
		npc.acc = (npc.acc or math.random() * npcStep) + dt
		if npc.acc >= npcStep then
			local ndt = npc.acc
			npc.acc = 0
			local ok, alive = pcall(stepNpc, npc, ndt, now)
			if not ok or not alive then
				local wasDead = npc.dead
				table.remove(npcs, i)
				if npc.real then
					Adopt.hidden[npc.model] = nil
				else
					if npc.model then npc.model:Destroy() end
					if wasDead and settings.npcRespawn then
						task.delay(2.5, function()
							if spawnedCount() < settings.maxNpcs then spawnOneNpc() end
						end)
					end
				end
			end
		end
	end

	adoptAcc += dt
	if adoptAcc >= 1 then
		adoptAcc = 0
		pcall(Adopt.tick, now, root)
	end

	hudAcc += dt
	if hudAcc >= HUD_STEP then
		hudAcc = 0
		UI.updateHud(drivenCar)
	end
	UI.updateStatus(dt)
end))

_G.__MonkeyVehicleStop = function()
	if drivenCar then pcall(exitCar, drivenCar, true) end
	pcall(function() RunService:UnbindFromRenderStep("MonkeyCamera") end)
	pcall(function() ContextActionService:UnbindAction("MonkeyDriveSink") end)
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	local cam = Workspace.CurrentCamera
	if cam then
		pcall(function()
			cam.FieldOfView = camState.baseFov
			if camState.scripted then cam.CameraType = Enum.CameraType.Custom end
		end)
	end
	for _, n in ipairs(npcs) do
		if n.real and n.ragdolled and not n.dead then pcall(recoverNpc, n) end
	end
	pcall(Net.restore)
	pcall(Adopt.releaseAll)
	if UI.gui then UI.gui:Destroy() end
	if world then world:Destroy() end
	_G.__MonkeyVehicleStop = nil
end

