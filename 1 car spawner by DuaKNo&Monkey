local function playSound(def, parent, volumeMul)
	if not settings.sounds or not def then return end
	local vol = (volumeMul or 1) * (settings.volume or 1)
	if vol <= 0 then return end
	local target = parent or fxFolder
	for _, layer in ipairs(def.layers) do
		local function fire()
			pcall(function()
				local s = Instance.new("Sound")
				s.SoundId = layer.id
				s.Volume = (layer.volume or 1) * vol
				s.PlaybackSpeed = (layer.speed or 1) * (1 + (math.random() - 0.5) * 2 * (layer.var or 0.06))
				s.RollOffMode = Enum.RollOffMode.InverseTapered
				s.RollOffMinDistance = 14
				s.RollOffMaxDistance = layer.range or 280
				for _, e in ipairs(layer.fx or {}) do
					local inst = Instance.new(e[1])
					for k, v in pairs(e[2]) do inst[k] = v end
					inst.Parent = s
				end
				s.Parent = target
				s:Play()
				Debris:AddItem(s, def.life or 4)
			end)
		end
		if layer.delay then task.delay(layer.delay, fire) else fire() end
	end
end

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

--// NETWORK OWNERSHIP + SIMULATION RADIUS -----------------------------------------
-- Raising your SimulationRadius makes the server hand you network ownership of the parts around
-- you. Once you own a map NPC, what your client does to it (health, position) is what everyone sees,
-- which is how a lethal car hit really kills the NPC. Needs an executor with sethiddenproperty;
-- isnetworkowner is used to confirm ownership when it exists.
local Net = { original = {} }

function Net.isOwner(part)
	if typeof(isnetworkowner) ~= "function" then return true end
	local ok, owned = pcall(isnetworkowner, part)
	return ok and owned == true
end

function Net.apply()
	if not drivenCar then return end
	local r = settings.simRadius
	if typeof(sethiddenproperty) == "function" then
		pcall(sethiddenproperty, player, "SimulationRadius", r)
		pcall(sethiddenproperty, player, "MaximumSimulationRadius", r)
	end
	pcall(function() player.MaximumSimulationRadius = r end)
end

function Net.restore()
	pcall(function()
		if Net.original.maxProp then player.MaximumSimulationRadius = Net.original.maxProp end
	end)
	if typeof(sethiddenproperty) ~= "function" then return end
	if Net.original.sim then pcall(sethiddenproperty, player, "SimulationRadius", Net.original.sim) end
	if Net.original.max then pcall(sethiddenproperty, player, "MaximumSimulationRadius", Net.original.max) end
end

do
	local okp, mp = pcall(function() return player.MaximumSimulationRadius end)
	if okp and type(mp) == "number" then Net.original.maxProp = mp end
end

if typeof(gethiddenproperty) == "function" then
	local ok1, sr = pcall(gethiddenproperty, player, "SimulationRadius")
	local ok2, mr = pcall(gethiddenproperty, player, "MaximumSimulationRadius")
	if ok1 and type(sr) == "number" then Net.original.sim = sr end
	if ok2 and type(mr) == "number" then Net.original.max = mr end
end

function Net.claim(root, timeout)
	Net.apply()
	if typeof(isnetworkowner) ~= "function" then return true end
	local t = os.clock()
	while os.clock() - t < (timeout or 1.5) do
		if Net.isOwner(root) then return true end
		Net.apply()
		RunService.Heartbeat:Wait()
	end
	return Net.isOwner(root)
end

function Net.kill(npc)
	task.spawn(function()
		local model, root, hum = npc.model, npc.root, npc.humanoid
		local owned = Net.claim(root, 1.5)
		if not owned then
			notify("Couldn't get ownership of that NPC - other players may not see it die")
		end
		pcall(function() hum.Health = 0 end)
		local t0 = os.clock()
		while os.clock() - t0 < 4 and model.Parent do
			Net.apply()
			pcall(function() hum.Health = 0 end)
			task.wait(0.5)
		end
	end)
end

function Net.snapToRest(model, root)
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("JointInstance") and d.Part0 and d.Part1 then
			if d:IsA("Motor6D") then d.Transform = CFrame.new() end
			table.insert(joints, d)
		end
	end
	local placed = { [root] = true }
	local progress = true
	while progress do
		progress = false
		for _, j in ipairs(joints) do
			local a, b = placed[j.Part0], placed[j.Part1]
			if a and not b then
				j.Part1.CFrame = j.Part0.CFrame * j.C0 * j.C1:Inverse()
				placed[j.Part1] = true
				progress = true
			elseif b and not a then
				j.Part0.CFrame = j.Part1.CFrame * j.C1 * j.C0:Inverse()
				placed[j.Part0] = true
				progress = true
			end
		end
	end
end

Net.apply()

--// NPC SYSTEM ---------------------------------------------------------------
local function createAvatarModel()
	local char, hum = getCharacter()
	local model
	if hum then
		local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
		if ok and desc then
			local ok2, m = pcall(function()
				return Players:CreateHumanoidModelFromDescription(desc, hum.RigType)
			end)
			if ok2 and m then model = m end
		end
	end
	if not model and char then
		char.Archivable = true
		model = char:Clone()
	end
	return model
end

local function cleanNpcModel(model)
	model.Name = "MonkeyNPC"
	local junk = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("ForceField") then
			table.insert(junk, d)
		end
	end
	for _, d in ipairs(junk) do d:Destroy() end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.RequiresNeck = false
		hum.BreakJointsOnDeath = false
		hum.WalkSpeed = 0
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = false
		model.PrimaryPart = root
	end
end

local function loadAnimations(npc)
	local hum = npc.humanoid
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local ids
	if hum.RigType == Enum.HumanoidRigType.R15 then
		ids = { idle = "rbxassetid://507766666", walk = "rbxassetid://507777826", run = "rbxassetid://507767714" }
	else
		ids = { idle = "rbxassetid://180435571", walk = "rbxassetid://180426354", run = "rbxassetid://180426354" }
	end
	npc.tracks = {}
	for name, id in pairs(ids) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
		if ok and tr then
			tr.Looped = true
			npc.tracks[name] = tr
		end
	end
end

local function setAnim(npc, name)
	if npc.currentAnim == name then return end
	local old = npc.currentAnim and npc.tracks[npc.currentAnim]
	if old then old:Stop(0.2) end
	local new = npc.tracks[name]
	if new then new:Play(0.2) end
	npc.currentAnim = name
end

local function stopAnims(npc)
	for _, t in pairs(npc.tracks) do
		t:Stop(0.1)
	end
	npc.currentAnim = nil
end

local function spawnOneNpc()
	if spawnedCount() >= settings.maxNpcs then
		notify("NPC limit reached (" .. settings.maxNpcs .. ")")
		return false
	end
	local char, hum, root = getCharacter()
	if not char then
		notify("No character found.")
		return false
	end
	task.spawn(function()
		local model = createAvatarModel()
		if not model then
			notify("Couldn't create an NPC.")
			return
		end
		cleanNpcModel(model)
		local nh = model:FindFirstChildOfClass("Humanoid")
		local nr = model:FindFirstChild("HumanoidRootPart")
		if not (nh and nr) then
			model:Destroy()
			notify("Couldn't create an NPC.")
			return
		end
		if spawnedCount() >= settings.maxNpcs then
			model:Destroy()
			return
		end

		local angle = math.random() * math.pi * 2
		local radius = math.random(18, 32)
		local p = root.Position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local hit = groundBelow(Vector3.new(p.X, root.Position.Y + 30, p.Z), { char, world })
		local gy = hit and hit.Position.Y or (root.Position.Y - 3)
		local spawnPos = Vector3.new(p.X, gy + nh.HipHeight + nr.Size.Y / 2 + 0.6, p.Z)
		model:PivotTo(CFrame.new(spawnPos))
		model.Parent = npcFolder

		local npc = {
			model = model, humanoid = nh, root = nr, home = spawnPos,
			ragdolled = false, recoverAt = 0, hitCooldown = 0, hp = 100, dead = false,
			nextWander = 0, target = nil, alertAt = 0,
			lastPos = spawnPos, lastCheck = 0,
			motors = {}, attachments = {}, tracks = {},
		}
		loadAnimations(npc)
		table.insert(npcs, npc)
	end)
	return true
end

local function spawnNpcs(count)
	local spawned = 0
	for _ = 1, count do
		if spawnOneNpc() then spawned += 1 else break end
		task.wait(0.05)
	end
	if spawned > 0 then
		notify(spawned == 1 and "NPC spawned" or (spawned .. " NPCs spawned"))
	end
end

local function clearNpcs()
	for i = #npcs, 1, -1 do
		local npc = npcs[i]
		if npc.real then
			Adopt.hidden[npc.model] = nil
			if npc.ragdolled and not npc.dead then Adopt.recover(npc) end
		else
			npc.model:Destroy()
		end
		table.remove(npcs, i)
	end
	notify("NPCs cleared")
end

--// ADOPT MAP NPCs --------------------------------------------------------------

local function isMapNpc(h)
	if not h:IsA("Humanoid") or h.Health <= 0 then return false end
	local m = h.Parent
	if not (m and m:IsA("Model")) or m:IsDescendantOf(world) then return false end
	if Players:GetPlayerFromCharacter(m) then return false end
	if player.Character and m == player.Character then return false end
	return m:FindFirstChild("HumanoidRootPart") ~= nil and m:FindFirstChild("Head") ~= nil
end

function Adopt.setHidden(model, hide)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				if hide then
					if Adopt.saved[d] == nil then Adopt.saved[d] = d.CanCollide end
					d.LocalTransparencyModifier = 1
					d.CanCollide = false
				else
					d.LocalTransparencyModifier = 0
					if Adopt.saved[d] ~= nil then d.CanCollide = Adopt.saved[d] end
				end
			end)
		end
	end
	local h = model:FindFirstChildOfClass("Humanoid")
	if h then
		pcall(function()
			h.DisplayDistanceType = hide and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer
		end)
	end
end

function Adopt.release(model)
	Adopt.hidden[model] = nil
end

function Adopt.take(h)
	local model = h.Parent
	if Adopt.hidden[model] then return end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (root and model:FindFirstChild("Head")) then return end
	Adopt.hidden[model] = true
	local pos = root.Position
	table.insert(npcs, {
		model = model, humanoid = h, root = root, home = pos, real = true, adopted = true,
		ragdolled = false, recoverAt = 0, hitCooldown = 0, hp = 100, dead = false,
		alertAt = 0, lastPos = pos, lastCheck = 0,
		motors = {}, attachments = {}, tracks = {},
	})
end

local function trackHumanoid(inst)
	if inst:IsA("Humanoid") then Adopt.known[inst] = true end
end
track(Workspace.DescendantAdded:Connect(trackHumanoid))
track(Workspace.DescendantRemoving:Connect(function(inst)
	Adopt.known[inst] = nil
end))
task.spawn(function()
	local n = 0
	for _, d in ipairs(Workspace:GetDescendants()) do
		trackHumanoid(d)
		n += 1
		if n % 4000 == 0 then task.wait() end
	end
end)

function Adopt.tick(now, root)
	Net.apply()
	for model in pairs(Adopt.hidden) do
		if not model.Parent then Adopt.hidden[model] = nil end
	end
	if not settings.adoptNpcs then
		for i = #npcs, 1, -1 do
			local npc = npcs[i]
			if npc.adopted then
				if npc.ragdolled and not npc.dead then Adopt.recover(npc) end
				table.remove(npcs, i)
			end
		end
		Adopt.releaseAll()
		return
	end
	if not root then return end
	local count = 0
	for _, npc in ipairs(npcs) do
		if npc.adopted then count += 1 end
	end
	if count >= settings.adoptMax then return end
	for h in pairs(Adopt.known) do
		if count >= settings.adoptMax then break end
		if h.Parent and isMapNpc(h) and not Adopt.hidden[h.Parent] then
			local hr = h.Parent:FindFirstChild("HumanoidRootPart")
			if hr and (hr.Position - root.Position).Magnitude <= settings.adoptRange then
				Adopt.take(h)
				count += 1
			end
		end
	end
end

function Adopt.releaseAll()
	for model in pairs(Adopt.hidden) do Adopt.release(model) end
end

local function findNpcByPart(part)
	local m = part:FindFirstAncestorOfClass("Model")
	if not m then return nil end
	for _, npc in ipairs(npcs) do
		if npc.model == m then return npc end
	end
	return nil
end

