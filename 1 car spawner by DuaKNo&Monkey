	local P = { text = C(235, 230, 245), sub = C(165, 155, 185), on = C(60, 140, 90), off = C(150, 60, 60), warn = C(235, 90, 90) }
	local EDGE = THEMES.Neon.edge
	local EDGE_PERIOD = 14
	local themed = setmetatable({}, { __mode = "k" })

	local function setPalette(name)
		local th = THEMES[name] or THEMES.Neon
		for k, v in pairs(th.pal) do P[k] = v end
		EDGE = th.edge
	end
	setPalette(settings.theme)

	local function recolorAll()
		for inst, props in pairs(themed) do
			if inst.Parent then
				for prop, key in pairs(props) do inst[prop] = P[key] end
			end
		end
	end

	local function edgeColor(t)
		local n = #EDGE
		local x = (t / EDGE_PERIOD % 1) * n
		local i = math.floor(x)
		local f = x - i
		f = f * f * (3 - 2 * f)
		return EDGE[i % n + 1]:Lerp(EDGE[(i + 1) % n + 1], f)
	end

	local function paint(inst, prop, key)
		inst[prop] = P[key]
		local t = themed[inst]
		if not t then
			t = {}
			themed[inst] = t
		end
		t[prop] = key
	end

	local function mk(class, props, parent, paints)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		if paints then
