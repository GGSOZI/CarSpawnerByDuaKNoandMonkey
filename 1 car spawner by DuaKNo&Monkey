			}, c, { TextColor3 = "accentText" })
			B.cur = c
			return c
		end
		function B.note(text, color)
			return mk("TextLabel", {
				LayoutOrder = B.o(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				Text = text, TextWrapped = true, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = color or P.sub,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			}, B.cur)
		end
		function B.box(placeholder, h)
			local b = box(B.cur, placeholder, UDim2.new(1, 0, 0, h or 30), nil, 12)
			b.LayoutOrder = B.o()
			return b
		end
		function B.row(h)
			return mk("Frame", { LayoutOrder = B.o(), Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1 }, B.cur)
		end
		function B.list()
			local f = mk("Frame", {
				LayoutOrder = B.o(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			}, B.cur)
			mk("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, f)
			return f
		end
		function B.grid(n, cols)
			cols = cols or 2
			local rows = math.ceil(n / cols)
			local g = mk("Frame", {
				LayoutOrder = B.o(), Size = UDim2.new(1, 0, 0, rows * 28 + (rows - 1) * 4), BackgroundTransparency = 1,
			}, B.cur)
			mk("UIGridLayout", {
				CellSize = cols == 1 and UDim2.new(1, 0, 0, 28) or UDim2.new(0.5, -2, 0, 28),
				CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder,
			}, g)
			return g
		end
		function B.cell(grid, textFn, activeFn, onClick)
			local b = button(grid, "", UDim2.new(), nil, "cardHi", 12)
			b.LayoutOrder = B.o()
			b.TextScaled = true
			mk("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8 }, b)
			b.Activated:Connect(function()
				onClick()
				UI.refresh()
			end)
			table.insert(UI.cells, { b = b, text = textFn, active = activeFn })
			return b
		end
		function B.toggle(grid, label, key, onChange)
			return B.cell(grid, function() return label .. ": " .. (settings[key] and "ON" or "OFF") end,
				function() return settings[key] end, function()
					settings[key] = not settings[key]
					if onChange then onChange(settings[key]) end
				end)
		end
		function B.cycle(grid, label, key, options, onChange)
			return B.cell(grid, function() return label .. ": " .. tostring(settings[key]) end, function() return false end, function()
				local idx = table.find(options, settings[key]) or 0
				settings[key] = options[idx % #options + 1]
				if onChange then onChange(settings[key]) end
			end)
		end
		function B.button(text, bgKey, onClick, h)
			local b = button(B.cur, text, UDim2.new(1, 0, 0, h or 28), nil, bgKey or "cardHi", 12)
			b.LayoutOrder = B.o()
			b.Activated:Connect(function()
				onClick()
				UI.refresh()
			end)
			return b
		end
		function B.stepper(label, key, min, max, step, fmt, onChange)
			local r = B.row(28)
			local minus = button(r, "-", UDim2.fromOffset(30, 28), UDim2.new(), "cardHi", 16)
			local plus = button(r, "+", UDim2.fromOffset(30, 28), UDim2.new(1, -30, 0, 0), "cardHi", 16)
			local lab = mk("TextLabel", {
				Size = UDim2.new(1, -68, 1, 0), Position = UDim2.fromOffset(34, 0), BorderSizePixel = 0,
				Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = P.text,
			}, r, { BackgroundColor3 = "field" })
			corner(lab, 4)
			local function refresh()
				local v = settings[key]
				lab.Text = label .. ": " .. (fmt and fmt(v) or tostring(v))
			end
			local function bump(dir)
				local v = settings[key] + dir * step
				v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
				settings[key] = math.floor(v * 1000 + 0.5) / 1000
				refresh()
				if onChange then onChange(settings[key]) end
			end
			minus.Activated:Connect(function() bump(-1) end)
			plus.Activated:Connect(function() bump(1) end)
			refresh()
			table.insert(UI.refreshers, refresh)
		end
		return B
	end

