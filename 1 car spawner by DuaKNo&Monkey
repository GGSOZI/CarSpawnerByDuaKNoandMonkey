	hornBtn.Activated:Connect(function()
		if drivenCar then playSound(SOUNDS.horn, drivenCar.chassis) end
	end)

	local lastValue = setmetatable({}, { __mode = "k" })
	local function setProp(obj, prop, value)
		local t = lastValue[obj]
		if not t then
			t = {}
			lastValue[obj] = t
		end
		if t[prop] ~= value then
			t[prop] = value
			obj[prop] = value
		end
	end
	local hudShown, controlsShown = false, false
	UI.updateHud = function(car)
		if not car then
			if hudShown then hud.Visible, hudShown = false, false end
			if controlsShown then controls.Visible, controlsShown = false, false end
			return
		end
		if not controlsShown then controls.Visible, controlsShown = true, true end
		local want = settings.showHud and true or false
		if hudShown ~= want then hud.Visible, hudShown = want, want end
		if not want then return end
		local mult = settings.units == "mph" and 0.621 or 1
		setProp(speedLabel, "Text", tostring(math.floor(math.abs(car.speed) * mult + 0.5)))
		setProp(unitLabel, "Text", settings.units == "mph" and "MPH" or "KM/H")
		setProp(nameLabel, "Text", car.spec.name .. "  -  " .. car.spec.tag)
		local maxSpd = car.spec.maxSpeed * settings.speedMult
		local ratio = math.clamp(math.abs(car.speed) / maxSpd, 0, 1.45)
		local gear = math.clamp(math.ceil(ratio * 6 - 0.001), 1, 6)
		local gearText
		if car.speed < -1 then
			gearText = "R"
		elseif math.abs(car.speed) < 1 then
			gearText = "N"
		else
			gearText = tostring(gear)
		end
		setProp(gearLabel, "Text", gearText)
		local band = (ratio * 6) % 1
		if ratio >= 1 then band = 1 end
		setProp(rpmFill, "BackgroundColor3", band > 0.85 and C(255, 70, 50) or P.accent)
		setProp(rpmFill, "Size", UDim2.new(math.floor(math.clamp(0.25 + band * 0.75, 0, 1) * 50) / 50, 0, 1, 0))
		setProp(nitroFill, "Size", UDim2.new(math.floor(math.clamp(car.nitro / 100, 0, 1) * 50) / 50, 0, 1, 0))
		local flags = ""
		if car.lightsOn then flags = "LIGHTS" end
		if car.siren and car.siren.on then flags = flags .. (flags ~= "" and "\n" or "") .. "SIREN" end
		if car.signal ~= 0 then
			flags = flags .. (flags ~= "" and "\n" or "") .. (car.signal == 2 and "HAZARD" or (car.signal < 0 and "<<" or ">>"))
		end
		setProp(flagsLabel, "Text", flags)
	end

	--// start ----------------------------------------------------------------------------------
	showTab(1)
	UI.renderSaved()
	UI.refresh()
